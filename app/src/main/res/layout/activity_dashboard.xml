<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Cabeçalho -->
        <TextView
            android:id="@+id/txtTituloDashboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MANBILE"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#1565C0" />

        <TextView
            android:id="@+id/txtBoasVindas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bem-vindo ao painel de manutenção móvel"
            android:textSize="16sp"
            android:textColor="#555555"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp" />

        <!-- Área principal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_card"
            android:elevation="3dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Acesso rápido"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1565C0"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnMinhasAtividades"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MINHAS ATIVIDADES"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1565C0"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnNovaAtividade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NOVA ATIVIDADE"
                android:textSize="16sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnHistorico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HISTÓRICO"
                android:textSize="16sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnRelatorios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RELATÓRIOS"
                android:textSize="16sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PERFIL"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Rodapé visual -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gestão móvel de atividades de manutenção técnica"
            android:textSize="13sp"
            android:textColor="#777777"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

</ScrollView>