<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Título da OS -->
        <TextView
            android:id="@+id/txtTituloDetalhes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OS #1025"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:layout_marginBottom="16dp" />

        <!-- Informações da atividade -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_card"
            android:elevation="3dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/txtCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cliente: Empresa Alfa"
                android:textSize="17sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/txtTipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tipo: Corretiva"
                android:textSize="17sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/txtPrioridade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prioridade: Urgente"
                android:textSize="17sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: Em deslocamento"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Atendimento técnico -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Atendimento técnico"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edtDiagnostico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Diagnóstico"
            android:minLines="3"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/edtSolucao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Solução aplicada"
            android:minLines="3"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:layout_marginBottom="20dp" />

        <!-- Local -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Local do atendimento"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edtCep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="CEP"
            android:inputType="number"
            android:maxLength="8"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnConsultarCep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONSULTAR CEP"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1565C0"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/txtEndereco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Endereço não consultado"
            android:textSize="16sp"
            android:padding="12dp"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="20dp" />

        <!-- Complemento do atendimento -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registro do atendimento"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edtMateriais"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Materiais utilizados"
            android:minLines="2"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/edtObservacoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Observações"
            android:minLines="3"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:layout_marginBottom="24dp" />

        <!-- Ações -->
        <Button
            android:id="@+id/btnSalvarAtividade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SALVAR"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1565C0"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnFinalizarAtividade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FINALIZAR ATIVIDADE"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E7D32"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>